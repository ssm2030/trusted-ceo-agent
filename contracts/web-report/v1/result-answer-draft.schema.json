{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-answer-draft.schema.json",
  "title": "ResultAnswerDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_version",
    "job_id",
    "run_id",
    "revision",
    "answer_blocks"
  ],
  "properties": {
    "draft_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "answer_blocks": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/supportedAnswerBlock"},
          {"$ref": "#/$defs/notSupportedAnswerBlock"}
        ]
      }
    }
  },
  "$defs": {
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyIdSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "emptyIdSet": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "supportedAnswerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "support_status",
        "text_template",
        "value_refs",
        "claim_refs",
        "evidence_link_ids",
        "source_refs"
      ],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "support_status": {"const": "supported"},
        "text_template": {"type": "string", "minLength": 1, "maxLength": 800},
        "value_refs": {"$ref": "#/$defs/idSet"},
        "claim_refs": {"$ref": "#/$defs/nonEmptyIdSet"},
        "evidence_link_ids": {"$ref": "#/$defs/nonEmptyIdSet"},
        "source_refs": {"$ref": "#/$defs/idSet"}
      }
    },
    "notSupportedAnswerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "support_status",
        "text_template",
        "value_refs",
        "claim_refs",
        "evidence_link_ids",
        "source_refs"
      ],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "support_status": {"const": "not_supported"},
        "text_template": {
          "const": "현재 실행본의 근거로는 확인할 수 없습니다"
        },
        "value_refs": {"$ref": "#/$defs/emptyIdSet"},
        "claim_refs": {"$ref": "#/$defs/emptyIdSet"},
        "evidence_link_ids": {"$ref": "#/$defs/emptyIdSet"},
        "source_refs": {"$ref": "#/$defs/emptyIdSet"}
      }
    }
  }
}
