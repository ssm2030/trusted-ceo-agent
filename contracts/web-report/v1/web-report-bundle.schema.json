{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-report-bundle.schema.json",
  "title": "WebReportBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "canonicalization_version",
    "run",
    "viewer_eligibility_receipt",
    "final_result",
    "presentation_manifest",
    "evidence_view",
    "source_view",
    "source_previews",
    "official_url_policy",
    "trust_view",
    "expert_packet_view",
    "revision_view",
    "file_manifest",
    "bundle_hash"
  ],
  "properties": {
    "bundle_version": {"const": "1.0.0"},
    "canonicalization_version": {"const": "rfc8785-jcs-1"},
    "run": {"$ref": "#/$defs/run"},
    "viewer_eligibility_receipt": {"$ref": "#/$defs/receipt"},
    "final_result": {"$ref": "#/$defs/finalResult"},
    "presentation_manifest": {"$ref": "presentation-manifest.schema.json"},
    "evidence_view": {"$ref": "#/$defs/evidenceView"},
    "source_view": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceViewItem"}
    },
    "source_previews": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourcePreview"}
    },
    "official_url_policy": {"$ref": "#/$defs/officialUrlPolicy"},
    "trust_view": {"$ref": "#/$defs/trustView"},
    "expert_packet_view": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/expertPacketViewItem"}
    },
    "revision_view": {"$ref": "#/$defs/revisionView"},
    "file_manifest": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileManifestItem"}
    },
    "bundle_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "revision",
        "workflow_state",
        "semantic_fingerprint",
        "finalization_event_time"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{16}$"
        },
        "revision": {"type": "integer", "minimum": 1},
        "workflow_state": {"const": "finalized"},
        "semantic_fingerprint": {"$ref": "#/$defs/hash"},
        "finalization_event_time": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "finalApprovalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "input_method",
        "fixture_only",
        "approval_id",
        "actor_role",
        "result_artifact_ref"
      ],
      "properties": {
        "gate": {"type": ["string", "null"], "minLength": 1},
        "status": {"type": ["string", "null"], "minLength": 1},
        "input_method": {
          "type": ["string", "null"],
          "enum": ["interactive_tty", "web_hitl", "test_fixture", null]
        },
        "fixture_only": {"type": ["boolean", "null"]},
        "approval_id": {"type": ["string", "null"], "minLength": 1},
        "actor_role": {"type": ["string", "null"], "minLength": 1},
        "result_artifact_ref": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_version",
        "claimed_viewer_mode",
        "run_id",
        "approved_revision",
        "finalized_revision",
        "workflow_state",
        "snapshot_manifest_hash",
        "final_result_hash",
        "result_artifact_ref",
        "revision_ancestry_hash",
        "validator_version",
        "completed_checks",
        "final_approval_summary"
      ],
      "properties": {
        "receipt_version": {"const": "1.0.0"},
        "claimed_viewer_mode": {
          "enum": ["trusted_final", "poc_fixture", "unverified_import"]
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{16}$"
        },
        "approved_revision": {"type": ["integer", "null"], "minimum": 1},
        "finalized_revision": {"type": "integer", "minimum": 1},
        "workflow_state": {"const": "finalized"},
        "snapshot_manifest_hash": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "final_result_hash": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "result_artifact_ref": {"type": ["string", "null"], "minLength": 1},
        "revision_ancestry_hash": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "validator_version": {"type": "string", "minLength": 1},
        "completed_checks": {"$ref": "#/$defs/idSet"},
        "final_approval_summary": {"$ref": "#/$defs/finalApprovalSummary"}
      }
    },
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "revision"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "missionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective"],
      "properties": {"objective": {"type": "string"}}
    },
    "capabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_code"],
      "properties": {"claim_code": {"type": "string", "minLength": 1}}
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "title_template",
        "primary_grade",
        "secondary_flags",
        "why_it_matters_template",
        "value_refs",
        "evidence_link_ids",
        "cause_hypotheses",
        "counter_hypotheses",
        "unresolved_conflicts",
        "verification_next_steps",
        "conditional_response_refs",
        "expert_review_refs"
      ],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "title_template": {"type": "string", "minLength": 1},
        "primary_grade": {
          "enum": [
            "Decision Required",
            "Immediate Verification",
            "Expert Review Required",
            "Monitor",
            "Appendix Signal",
            "Not Assessable"
          ]
        },
        "secondary_flags": {"$ref": "#/$defs/idSet"},
        "why_it_matters_template": {"type": "string"},
        "value_refs": {"$ref": "#/$defs/idSet"},
        "evidence_link_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cause_hypotheses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/claim"}
        },
        "counter_hypotheses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/claim"}
        },
        "unresolved_conflicts": {"$ref": "#/$defs/idSet"},
        "verification_next_steps": {"$ref": "#/$defs/idSet"},
        "conditional_response_refs": {"$ref": "#/$defs/idSet"},
        "expert_review_refs": {"$ref": "#/$defs/idSet"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "from_issue_ref",
        "to_issue_ref",
        "relation_type"
      ],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "from_issue_ref": {"type": "string", "minLength": 1},
        "to_issue_ref": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_id", "condition_template", "direction_template"],
      "properties": {
        "response_id": {"type": "string", "minLength": 1},
        "condition_template": {"type": "string"},
        "direction_template": {"type": "string"}
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monitor_id", "metric_ref", "condition_template"],
      "properties": {
        "monitor_id": {"type": "string", "minLength": 1},
        "metric_ref": {"type": "string", "minLength": 1},
        "condition_template": {"type": "string"}
      }
    },
    "blindSpot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind_spot_id", "description_template"],
      "properties": {
        "blind_spot_id": {"type": "string", "minLength": 1},
        "description_template": {"type": "string"}
      }
    },
    "publicExpertPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expert_packet_id",
        "profession",
        "question_template",
        "forbidden_conclusions"
      ],
      "properties": {
        "expert_packet_id": {"type": "string", "minLength": 1},
        "profession": {"type": "string", "minLength": 1},
        "question_template": {"type": "string", "minLength": 1},
        "forbidden_conclusions": {"$ref": "#/$defs/idSet"}
      }
    },
    "finalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_summary",
        "mission_summary",
        "capability_summary",
        "issues",
        "cross_issue_relations",
        "conditional_responses",
        "monitoring",
        "blind_spots",
        "expert_review_packets",
        "approvals",
        "integrity"
      ],
      "properties": {
        "run_summary": {"$ref": "#/$defs/runSummary"},
        "mission_summary": {"$ref": "#/$defs/missionSummary"},
        "capability_summary": {"$ref": "#/$defs/capabilitySummary"},
        "issues": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/issue"}
        },
        "cross_issue_relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relation"}
        },
        "conditional_responses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/response"}
        },
        "monitoring": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/monitor"}
        },
        "blind_spots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/blindSpot"}
        },
        "expert_review_packets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/publicExpertPacket"}
        },
        "approvals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/finalApprovalSummary"}
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_fingerprint"],
          "properties": {
            "semantic_fingerprint": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "scopeMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_code", "member_code"],
      "properties": {
        "dimension_code": {"type": "string", "minLength": 1},
        "member_code": {"type": "string", "minLength": 1}
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "periodContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period"],
      "properties": {"period": {"type": "string", "minLength": 1}}
    },
    "asOfContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of"],
      "properties": {"as_of": {"type": "string", "format": "date"}}
    },
    "windowContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window"],
      "properties": {"window": {"$ref": "#/$defs/timeWindow"}}
    },
    "factValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_type",
        "canonical_value",
        "unit_code",
        "currency_code",
        "scale"
      ],
      "properties": {
        "value_type": {
          "enum": [
            "decimal",
            "integer",
            "string",
            "boolean",
            "date",
            "datetime",
            "category"
          ]
        },
        "canonical_value": {"type": ["string", "integer", "boolean"]},
        "unit_code": {"type": ["string", "null"]},
        "currency_code": {"type": ["string", "null"]},
        "scale": {"type": ["string", "null"]}
      }
    },
    "csvLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_indices"],
      "properties": {
        "record_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "jsonLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer"],
      "properties": {
        "pointer": {"type": "string", "pattern": "^(|/.*)$"}
      }
    },
    "xlsxLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet", "range"],
      "properties": {
        "sheet": {"type": "string", "minLength": 1},
        "range": {
          "type": "string",
          "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {"type": "string"},
        "operator": {"type": "string"},
        "value": {"type": ["string", "integer", "number", "boolean", "null"]}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "observation_role",
        "locator_type",
        "locator",
        "selected_fields",
        "record_count",
        "filters",
        "group_by",
        "operation",
        "normalized_rows_hash",
        "row_multiset_hash",
        "lineage_set_ref",
        "extraction_hash"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "observation_role": {"type": "string", "minLength": 1},
        "locator_type": {"enum": ["csv_records", "json_pointer", "xlsx_cells"]},
        "locator": {
          "oneOf": [
            {"$ref": "#/$defs/csvLocator"},
            {"$ref": "#/$defs/jsonLocator"},
            {"$ref": "#/$defs/xlsxLocator"}
          ]
        },
        "selected_fields": {"$ref": "#/$defs/idSet"},
        "record_count": {"type": "integer", "minimum": 1},
        "filters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/filter"}
        },
        "group_by": {"$ref": "#/$defs/idSet"},
        "operation": {"type": "string", "minLength": 1},
        "normalized_rows_hash": {"$ref": "#/$defs/hash"},
        "row_multiset_hash": {"$ref": "#/$defs/hash"},
        "lineage_set_ref": {
          "type": "string",
          "pattern": "^lineage/sets/[0-9a-f]{64}\\.json$"
        },
        "extraction_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_version",
        "operation_code",
        "formula_ref",
        "parameter_hash",
        "input_fact_ids",
        "component_run_id"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_version": {"type": "string", "minLength": 1},
        "operation_code": {"type": "string", "minLength": 1},
        "formula_ref": {"type": "string", "minLength": 1},
        "parameter_hash": {"$ref": "#/$defs/hash"},
        "input_fact_ids": {"$ref": "#/$defs/idSet"},
        "component_run_id": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_code",
        "fact_type",
        "metric_code",
        "semantic_role",
        "observation_role",
        "scope",
        "time_context",
        "value",
        "source_refs",
        "derivation",
        "quality",
        "producer",
        "integrity"
      ],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "fact_code": {"type": "string", "minLength": 1},
        "fact_type": {"enum": ["observed", "aggregated", "calculated"]},
        "metric_code": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "observation_role": {"type": "string", "minLength": 1},
        "scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scopeMember"}
        },
        "time_context": {
          "oneOf": [
            {"$ref": "#/$defs/periodContext"},
            {"$ref": "#/$defs/asOfContext"},
            {"$ref": "#/$defs/windowContext"}
          ]
        },
        "value": {"$ref": "#/$defs/factValue"},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceReference"}
        },
        "derivation": {
          "oneOf": [{"$ref": "#/$defs/derivation"}, {"type": "null"}]
        },
        "quality": {"$ref": "#/$defs/idSet"},
        "producer": {"enum": ["runtime_intake", "deterministic_component"]},
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload_hash"],
          "properties": {"payload_hash": {"$ref": "#/$defs/hash"}}
        }
      }
    },
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_version", "component_run_id"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_version": {"type": "string", "minLength": 1},
        "component_run_id": {"type": "string", "minLength": 1}
      }
    },
    "evaluationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "integer", "boolean", "null"]}
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "signal_code",
        "rule_ref",
        "component_ref",
        "threshold_ref",
        "input_fact_ids",
        "required_fact_codes",
        "missing_fact_codes",
        "scope",
        "time_context",
        "evaluation",
        "outcome",
        "direction",
        "impact_band_candidate",
        "urgency_band_candidate",
        "reason_codes",
        "producer"
      ],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "signal_code": {"type": "string", "minLength": 1},
        "rule_ref": {"type": "string", "minLength": 1},
        "component_ref": {"$ref": "#/$defs/componentRef"},
        "threshold_ref": {"type": ["string", "null"]},
        "input_fact_ids": {"$ref": "#/$defs/idSet"},
        "required_fact_codes": {"$ref": "#/$defs/idSet"},
        "missing_fact_codes": {"$ref": "#/$defs/idSet"},
        "scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scopeMember"}
        },
        "time_context": {
          "oneOf": [
            {"$ref": "#/$defs/periodContext"},
            {"$ref": "#/$defs/asOfContext"},
            {"$ref": "#/$defs/windowContext"}
          ]
        },
        "evaluation": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evaluationEntry"}
        },
        "outcome": {"enum": ["triggered", "not_triggered", "not_assessable"]},
        "direction": {"type": ["string", "null"]},
        "impact_band_candidate": {
          "enum": ["critical", "high", "medium", "low", null]
        },
        "urgency_band_candidate": {
          "enum": ["immediate", "near_term", "routine", null]
        },
        "reason_codes": {"$ref": "#/$defs/idSet"},
        "producer": {"const": "deterministic_component"}
      }
    },
    "valueReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "fact_or_signal_id",
        "display_field",
        "display_format_ref"
      ],
      "properties": {
        "token": {"type": "string", "minLength": 1},
        "fact_or_signal_id": {"type": "string", "minLength": 1},
        "display_field": {"type": "string", "minLength": 1},
        "display_format_ref": {"type": "string", "minLength": 1}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_type",
        "origin_job_id",
        "model_profile",
        "prompt_hash",
        "proposal_hash"
      ],
      "properties": {
        "origin_type": {
          "enum": ["model_proposal", "deterministic_rule", "human_overlay"]
        },
        "origin_job_id": {"type": ["string", "null"]},
        "model_profile": {"type": ["string", "null"]},
        "prompt_hash": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "proposal_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_link_id",
        "target_ref",
        "target_type",
        "evidence_ref",
        "evidence_kind",
        "polarity",
        "role",
        "rationale_template",
        "value_refs",
        "stage",
        "materialized_by",
        "origin",
        "independence_group_id"
      ],
      "properties": {
        "evidence_link_id": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "target_type": {
          "enum": [
            "business_meaning",
            "problem_candidate",
            "cause_hypothesis",
            "counter_hypothesis",
            "integrated_issue",
            "causal_relation_hypothesis",
            "cross_issue_conflict",
            "conditional_response",
            "expert_review_need"
          ]
        },
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["fact", "signal"]},
        "polarity": {"enum": ["supports", "contradicts"]},
        "role": {
          "enum": [
            "observation",
            "corroboration",
