{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-task-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "work_idempotency_key",
    "producer",
    "status",
    "findings",
    "expert_packet_refs",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"},
    "work_idempotency_key": {"type": "string", "pattern": "^idem_[0-9a-f]{64}$"},
    "producer": {"const": "approved_pack_procedure"},
    "status": {
      "enum": ["succeeded", "expert_review_required", "not_assessable"]
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_key", "assessment_domains", "spec"],
        "properties": {
          "finding_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "assessment_domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["accounting", "labor", "legal", "tax"]}
          },
          "spec": {"type": "object"}
        }
      }
    },
    "expert_packet_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
