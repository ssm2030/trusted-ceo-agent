{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-join-manifest.schema.json",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {"enum": ["accounting", "labor", "legal", "tax"]},
    "terminalStatus": {
      "enum": [
        "completed", "not_assessable", "unsupported_pack",
        "expert_review_required", "not_applicable", "excluded_by_approved_scope"
      ]
    },
    "authority": {"enum": ["none", "machine_draft", "boundary", "provisional", "full"]},
    "routeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "domain", "required", "status", "authority", "payload_hash"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^route_[0-9a-f]{24}$"},
        "domain": {"$ref": "#/$defs/domain"},
        "required": {"type": "boolean"},
        "status": {"$ref": "#/$defs/terminalStatus"},
        "authority": {"$ref": "#/$defs/authority"},
        "payload_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "assessmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "route_id", "domain", "status", "authority", "content_hash"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "route_id": {"type": "string", "pattern": "^route_[0-9a-f]{24}$"},
        "domain": {"$ref": "#/$defs/domain"},
        "status": {"$ref": "#/$defs/terminalStatus"},
        "authority": {"$ref": "#/$defs/authority"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "findingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "content_hash"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{24}$"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "relationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "content_hash"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^relation_[0-9a-f]{24}$"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "clusterInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "content_hash"],
      "properties": {
        "cluster_id": {"type": "string", "pattern": "^cluster_[0-9a-f]{24}$"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "run_id", "revision", "event_ref",
    "pack_manifest_hash", "writer_id", "route_inputs", "assessment_inputs",
    "finding_inputs", "relation_inputs", "cluster_inputs", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^findingjoin_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_.-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "payload_hash"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^event_[0-9a-f]{24}$"},
        "payload_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "pack_manifest_hash": {"$ref": "#/$defs/hash"},
    "writer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "route_inputs": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "uniqueItems": true, "items": {"$ref": "#/$defs/routeInput"}
    },
    "assessment_inputs": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "uniqueItems": true, "items": {"$ref": "#/$defs/assessmentInput"}
    },
    "finding_inputs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/findingInput"}
    },
    "relation_inputs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/relationInput"}
    },
    "cluster_inputs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/clusterInput"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_hash"],
      "properties": {"payload_hash": {"$ref": "#/$defs/hash"}}
    }
  }
}
