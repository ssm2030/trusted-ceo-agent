{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_evidence_id",
    "source_id",
    "logical_path",
    "chunk_index",
    "heading_path",
    "line_start",
    "line_end",
    "content",
    "content_sha256",
    "normalized_document_sha256",
    "locator_type",
    "integrity"
  ],
  "properties": {
    "document_evidence_id": {"type": "string", "pattern": "^document_[0-9a-f]{24}$"},
    "source_id": {"type": "string", "pattern": "^source_[0-9a-f]{24}$"},
    "logical_path": {"type": "string", "minLength": 1, "maxLength": 512},
    "chunk_index": {"type": "integer", "minimum": 1},
    "heading_path": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "line_start": {"type": "integer", "minimum": 1},
    "line_end": {"type": "integer", "minimum": 1},
    "content": {"type": "string", "minLength": 1, "maxLength": 2000},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator_type": {"const": "markdown_lines"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_hash"],
      "properties": {
        "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
