{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-approval-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_request_id", "approval_stage", "object_id",
    "object_hash", "expected_revision", "requested_action", "requested_by",
    "required_role", "nonce_hash", "requested_at", "expires_at", "status",
    "request_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "approval_request_id": {"type": "string", "pattern": "^knowledgeapprovalrequest_[0-9a-f]{24}$"},
    "approval_stage": {"enum": ["feedback_submit", "patch_approve", "release_deploy"]},
    "object_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "object_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "requested_action": {"enum": ["submit_feedback", "approve_patch", "deploy_release", "rollback_release"]},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "required_role": {"type": "string", "minLength": 1, "maxLength": 128},
    "nonce_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"const": "pending"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
