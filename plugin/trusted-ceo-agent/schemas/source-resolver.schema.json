{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original_path_token", "absolute_path"],
        "properties": {
          "original_path_token": {"type": "string", "pattern": "^path_[0-9a-f]{24}$"},
          "absolute_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
