{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "problem-pack.schema.json",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "pack_type",
                     "pack_id",
                     "pack_version",
                     "requested_authority",
                     "title",
                     "description",
                     "applicability",
                     "dependencies",
                     "safety",
                     "content"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  "1.0.0"
                                          },
                       "pack_type":  {
                                         "const":  "problem"
                                     },
                       "pack_id":  {
                                       "type":  "string"
                                   },
                       "pack_version":  {
                                            "type":  "string"
                                        },
                       "requested_authority":  {
                                                   "enum":  [
                                                                "full",
                                                                "provisional",
                                                                "boundary"
                                                            ]
                                               },
                       "title":  {
                                     "type":  "string"
                                 },
                       "description":  {
                                           "type":  "string"
                                       },
                       "applicability":  {
                                             "$ref":  "#/$defs/applicability"
                                         },
                       "dependencies":  {
                                            "type":  "array",
                                            "items":  {
                                                          "type":  "string"
                                                      },
                                            "uniqueItems":  true
                                        },
                       "safety":  {
                                      "$ref":  "#/$defs/safety"
                                  },
                       "content":  {
                                       "type":  "object",
                                       "required":  [
                                                        "problem_family_code",
                                                        "domain_pack_refs",
                                                        "entry_conditions",
                                                        "required_capabilities",
                                                        "capability_requirements",
                                                        "lens_plan",
                                                        "analysis_plan",
                                                        "hypothesis_templates",
                                                        "evidence_requirements",
                                                        "distinguishing_tests",
                                                        "decision_type_catalog",
                                                        "blocking_counter_evidence_conditions",
                                                        "deep_dive_plan",
                                                        "conditional_response_catalog",
                                                        "expert_trigger_refs",
                                                        "not_assessable_rules",
                                                        "stop_rules"
                                                    ],
                                       "properties":  {
                                                          "problem_family_code":  {
                                                                                      "type":  "string"
                                                                                  },
                                                          "domain_pack_refs":  {
                                                                                   "type":  "array",
                                                                                   "items":  {
                                                                                                 "type":  "string"
                                                                                             },
                                                                                   "minItems":  1
                                                                               },
                                                          "entry_conditions":  {
                                                                                   "type":  "array",
                                                                                   "items":  {
                                                                                                 "type":  "object"
                                                                                             },
                                                                                   "minItems":  1
                                                                               },
                                                          "required_capabilities":  {
                                                                                        "type":  "array",
                                                                                        "items":  {
                                                                                                      "type":  "string"
                                                                                                  },
                                                                                        "minItems":  1,
                                                                                        "uniqueItems":  true
                                                                                    },
                                                          "lens_plan":  {
                                                                            "type":  "array",
                                                                            "items":  {
                                                                                          "$ref":  "#/$defs/lens"
                                                                                      },
                                                                            "minItems":  2
                                                                        },
                                                          "analysis_plan":  {
                                                                                "type":  "array",
                                                                                "items":  {
                                                                                              "$ref":  "#/$defs/component_step"
                                                                                          }
                                                                            },
                                                          "hypothesis_templates":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "object"
                                                                                                 }
                                                                                   },
                                                          "evidence_requirements":  {
                                                                                        "type":  "array",
                                                                                        "items":  {
                                                                                                      "type":  "object"
                                                                                                  }
                                                                                    },
                                                          "distinguishing_tests":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "object"
                                                                                                 }
                                                                                   },
                                                          "decision_type_catalog":  {
                                                                                        "type":  "array",
                                                                                        "items":  {
                                                                                                      "type":  "object"
                                                                                                  }
                                                                                    },
                                                          "blocking_counter_evidence_conditions":  {
                                                                                                       "type":  "array",
                                                                                                       "items":  {
                                                                                                                     "$ref":  "#/$defs/blocking"
                                                                                                                 }
                                                                                                   },
                                                          "deep_dive_plan":  {
                                                                                 "type":  "array",
                                                                                 "items":  {
                                                                                               "$ref":  "#/$defs/component_step"
                                                                                           }
                                                                             },
                                                          "conditional_response_catalog":  {
                                                                                               "type":  "array",
                                                                                               "items":  {
                                                                                                             "type":  "object"
                                                                                                         }
                                                                                           },
                                                          "expert_trigger_refs":  {
                                                                                      "type":  "array",
                                                                                      "items":  {
                                                                                                    "type":  "string"
                                                                                                }
                                                                                  },
                                                          "not_assessable_rules":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "string"
                                                                                                 }
                                                                                   },
                                                          "stop_rules":  {
                                                                             "type":  "array",
                                                                             "items":  {
                                                                                           "type":  "string"
                                                                                       }
                                                                         },
                                                          "capability_requirements":  {
                                                                                          "type":  "array",
                                                                                          "minItems":  1,
                                                                                          "items":  {
                                                                                                        "$ref":  "#/$defs/capability_requirement"
                                                                                                    }
                                                                                      }
                                                      },
                                       "additionalProperties":  false
                                   }
                   },
    "additionalProperties":  false,
    "$defs":  {
                  "applicability":  {
                                        "type":  "object",
                                        "required":  [
                                                         "business_models",
                                                         "industries",
                                                         "excluded_industries",
                                                         "required_data_roles"
                                                     ],
                                        "properties":  {
                                                           "business_models":  {
                                                                                   "type":  "array",
                                                                                   "items":  {
                                                                                                 "type":  "string"
                                                                                             },
                                                                                   "uniqueItems":  true
                                                                               },
                                                           "industries":  {
                                                                              "type":  "array",
                                                                              "items":  {
                                                                                            "type":  "string"
                                                                                        },
                                                                              "uniqueItems":  true
                                                                          },
                                                           "excluded_industries":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "string"
                                                                                                 },
                                                                                       "uniqueItems":  true
                                                                                   },
                                                           "required_data_roles":  {
                                                                                       "type":  "array",
                                                                                       "items":  {
                                                                                                     "type":  "string"
                                                                                                 },
                                                                                       "uniqueItems":  true
                                                                                   }
                                                       },
                                        "additionalProperties":  false
                                    },
                  "safety":  {
                                 "type":  "object",
                                 "required":  [
                                                  "forbidden_interpretations",
                                                  "safe_stop_rules"
                                              ],
                                 "properties":  {
                                                    "forbidden_interpretations":  {
                                                                                      "type":  "array",
                                                                                      "items":  {
                                                                                                    "type":  "string"
                                                                                                }
                                                                                  },
                                                    "safe_stop_rules":  {
                                                                            "type":  "array",
                                                                            "items":  {
                                                                                          "type":  "string"
                                                                                      }
                                                                        }
                                                },
                                 "additionalProperties":  false
                             },
                  "lens":  {
                               "type":  "object",
                               "required":  [
                                                "lens_id",
                                                "role",
                                                "required",
                                                "capability_refs",
                                                "allowed_mechanism_refs",
                                                "max_shards"
                                            ],
                               "properties":  {
                                                  "lens_id":  {
                                                                  "type":  "string"
                                                              },
                                                  "role":  {
                                                               "enum":  [
                                                                            "requested",
                                                                            "challenge",
                                                                            "control",
                                                                            "timing",
                                                                            "customer",
                                                                            "operational",
                                                                            "financial"
                                                                        ]
                                                           },
                                                  "required":  {
                                                                   "type":  "boolean"
                                                               },
                                                  "capability_refs":  {
                                                                          "type":  "array",
                                                                          "items":  {
                                                                                        "type":  "string"
                                                                                    }
                                                                      },
                                                  "allowed_mechanism_refs":  {
                                                                                 "type":  "array",
                                                                                 "items":  {
                                                                                               "type":  "string"
                                                                                           }
                                                                             },
                                                  "max_shards":  {
                                                                     "type":  "integer",
                                                                     "minimum":  1,
                                                                     "maximum":  6
                                                                 }
                                              },
                               "additionalProperties":  false
                           },
                  "component_step":  {
                                         "type":  "object",
                                         "required":  [
                                                          "component_id",
                                                          "purpose",
                                                          "parameter_template"
                                                      ],
                                         "properties":  {
                                                            "component_id":  {
                                                                                 "type":  "string"
                                                                             },
                                                            "purpose":  {
                                                                            "type":  "string"
                                                                        },
                                                            "parameter_template":  {
                                                                                       "type":  "object",
                                                                                       "additionalProperties":  {
                                                                                                                    "if":  {
                                                                                                                               "type":  "object",
                                                                                                                               "required":  [
                                                                                                                                                "fact_selector"
                                                                                                                                            ]
                                                                                                                           },
                                                                                                                    "then":  {
                                                                                                                                 "$ref":  "#/$defs/fact_binding"
                                                                                                                             }
                                                                                                                }
                                                                                   }
                                                        },
                                         "additionalProperties":  false
                                     },
                  "fact_binding":  {
                                       "type":  "object",
                                       "required":  [
                                                        "fact_selector"
                                                    ],
                                       "properties":  {
                                                          "fact_selector":  {
                                                                                "$ref":  "#/$defs/fact_selector"
                                                                            }
                                                      },
                                       "additionalProperties":  false
                                   },
                  "fact_selector":  {
                                        "type":  "object",
                                        "required":  [
                                                         "fact_code",
                                                         "cardinality",
                                                         "time_role",
                                                         "scope_relation"
                                                     ],
                                        "properties":  {
                                                           "fact_code":  {
                                                                             "type":  "string",
                                                                             "minLength":  1
                                                                         },
                                                           "cardinality":  {
                                                                               "enum":  [
                                                                                            "one",
                                                                                            "many"
                                                                                        ]
                                                                           },
                                                           "time_role":  {
                                                                             "enum":  [
                                                                                          "all",
                                                                                          "earliest",
                                                                                          "previous",
                                                                                          "latest"
                                                                                      ]
                                                                         },
                                                           "scope_relation":  {
                                                                                  "enum":  [
                                                                                               "any",
                                                                                               "issue"
                                                                                           ]
                                                                              },
                                                           "observation_role":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  1
                                                                                },
                                                           "unit_code":  {
                                                                             "type":  "string",
                                                                             "minLength":  1
                                                                         }
                                                       },
                                        "additionalProperties":  false
                                    },
                  "blocking":  {
                                   "type":  "object",
                                   "required":  [
                                                    "condition_ref",
                                                    "target_problem_family",
                                                    "condition_expression",
                                                    "reason_code"
                                                ],
                                   "properties":  {
                                                      "condition_ref":  {
                                                                            "type":  "string"
                                                                        },
                                                      "target_problem_family":  {
                                                                                    "type":  "string"
                                                                                },
                                                      "condition_expression":  {
                                                                                   "type":  "object"
                                                                               },
                                                      "reason_code":  {
                                                                          "type":  "string"
                                                                      }
                                                  },
                                   "additionalProperties":  false
                               },
                  "capability_requirement":  {
                                                 "type":  "object",
                                                 "required":  [
                                                                  "capability_code",
                                                                  "required_fact_codes",
                                                                  "required_observation_roles"
                                                              ],
                                                 "properties":  {
                                                                    "capability_code":  {
                                                                                            "type":  "string",
                                                                                            "minLength":  1
                                                                                        },
                                                                    "required_fact_codes":  {
                                                                                                "type":  "array",
                                                                                                "items":  {
                                                                                                              "type":  "string",
                                                                                                              "minLength":  1
                                                                                                          },
                                                                                                "minItems":  1,
                                                                                                "uniqueItems":  true
                                                                                            },
                                                                    "required_observation_roles":  {
                                                                                                       "type":  "array",
                                                                                                       "items":  {
                                                                                                                     "type":  "string",
                                                                                                                     "minLength":  1
                                                                                                                 },
                                                                                                       "minItems":  1,
                                                                                                       "uniqueItems":  true
                                                                                                   }
                                                                },
                                                 "additionalProperties":  false
                                             }
              }
}
