{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-checkpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "graph_id",
    "run_id",
    "base_revision",
    "created_from_hash",
    "policy_release_id",
    "sequence",
    "previous_checkpoint_ref",
    "task_states",
    "pending_task_ids",
    "ready_task_ids",
    "running_task_ids",
    "terminal_task_ids",
    "result_records",
    "content_hash"
  ],
  "properties": {
    "checkpoint_id": {"type": "string", "pattern": "^checkpoint_[0-9a-f]{24}$"},
    "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "created_from_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_release_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_checkpoint_ref": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "task_states": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/taskState"}
    },
    "pending_task_ids": {"$ref": "#/$defs/taskIdSet"},
    "ready_task_ids": {"$ref": "#/$defs/taskIdSet"},
    "running_task_ids": {"$ref": "#/$defs/taskIdSet"},
    "terminal_task_ids": {"$ref": "#/$defs/taskIdSet"},
    "result_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "result_ref", "result_hash"],
        "properties": {
          "task_id": {"$ref": "#/$defs/taskId"},
          "result_ref": {"type": "string", "minLength": 1},
          "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"},
    "taskIdSet": {
      "type": "array",
      "items": {"$ref": "#/$defs/taskId"},
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "leased",
        "running",
        "succeeded",
        "needs_input",
        "deep_review_pending",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "failureCode": {
      "enum": [
        "contract_invalid",
        "packet_hash_mismatch",
        "source_unavailable",
        "model_timeout",
        "model_contract_failure",
        "procedure_failed",
        "required_evidence_missing",
        "stale_revision",
        "cancelled_by_human",
        "resource_exhausted",
        "unsupported_pack"
      ]
    },
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "attempt",
        "packet_hash",
        "lease_owner",
        "lease_started_at",
        "result_ref",
        "result_hash",
        "failure_code"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "status": {"$ref": "#/$defs/status"},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 2},
        "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lease_owner": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "lease_started_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "result_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "result_hash": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "failure_code": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failureCode"}
          ]
        }
      }
    }
  }
}
