{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-analysis-runtime-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "execution_authority",
    "event",
    "routing_decisions",
    "domain_routes",
    "signal_cases",
    "priority_records",
    "graphs",
    "checkpoints",
    "budget_assessments",
    "work_items",
    "result_cas",
    "domain_assessments",
    "findings",
    "grading_inputs",
    "grade_records",
    "relations",
    "clusters",
    "finding_join_manifest",
    "cross_domain_integration",
    "completion",
    "finalization_allowed",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_.-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "execution_authority": {"$ref": "execution-authority-gate.schema.json"},
    "event": {"$ref": "economic-event.schema.json"},
    "routing_decisions": {
      "type": "array",
      "items": {"$ref": "domain-route.schema.json"}
    },
    "domain_routes": {
      "type": "array",
      "items": {"$ref": "domain-route.schema.json"}
    },
    "signal_cases": {
      "type": "array",
      "items": {"$ref": "signal-case.schema.json"}
    },
    "priority_records": {
      "type": "array",
      "items": {"$ref": "priority-record.schema.json"}
    },
    "graphs": {
      "type": "array",
      "items": {"$ref": "analysis-work-graph.schema.json"}
    },
    "checkpoints": {
      "type": "array",
      "items": {"$ref": "work-checkpoint.schema.json"}
    },
    "budget_assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/budgetAssessment"}
    },
    "work_items": {
      "type": "array",
      "items": {"$ref": "analysis-work-item.schema.json"}
    },
    "result_cas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_ref", "result_hash", "payload"],
        "properties": {
          "result_ref": {
            "type": "string",
            "pattern": "^cas/results/[0-9a-f]{64}\\.json$"
          },
          "result_hash": {"$ref": "#/$defs/hash"},
          "payload": {"$ref": "professional-task-result.schema.json"}
        }
      }
    },
    "domain_assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/domainAssessment"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "finding-record.schema.json"}
    },
    "grading_inputs": {
      "type": "array",
      "items": {"$ref": "grading-input.schema.json"}
    },
    "grade_records": {
      "type": "array",
      "items": {"$ref": "grade-record.schema.json"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "finding-relation.schema.json"}
    },
    "clusters": {
      "type": "array",
      "items": {"$ref": "issue-cluster.schema.json"}
    },
    "finding_join_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "finding-join-manifest.schema.json"}
      ]
    },
    "cross_domain_integration": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "cross-domain-integration.schema.json"}
      ]
    },
    "completion": {"$ref": "completion-assessment.schema.json"},
    "finalization_allowed": {"type": "boolean"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budgetAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_id",
        "case_id",
        "elapsed_seconds",
        "status",
        "required_task_ids",
        "scheduled_task_ids",
        "deferred_optional_task_ids",
        "coverage_records",
        "content_hash"
      ],
      "properties": {
        "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{24}$"},
        "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{24}$"},
        "elapsed_seconds": {"type": "integer", "minimum": 0},
        "status": {
          "enum": [
            "ready",
            "needs_prioritization",
            "needs_input",
            "deep_review_pending"
          ]
        },
        "required_task_ids": {"$ref": "#/$defs/taskIdSet"},
        "scheduled_task_ids": {"$ref": "#/$defs/taskIdSet"},
        "deferred_optional_task_ids": {"$ref": "#/$defs/taskIdSet"},
        "coverage_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "reason"],
            "properties": {
              "task_id": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"},
              "reason": {"const": "optional_budget_deferred"}
            }
          }
        },
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "taskIdSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"}
    },
    "domainAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "route_id",
        "event_id",
        "domain",
        "revision",
        "status",
        "authority",
        "finding_ids",
        "additional_data_refs",
        "expert_role",
        "content_hash"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "pattern": "^assessment_[0-9a-f]{24}$"
        },
        "route_id": {"type": "string", "pattern": "^route_[0-9a-f]{24}$"},
        "event_id": {"type": "string", "pattern": "^event_[0-9a-f]{24}$"},
        "domain": {"enum": ["accounting", "labor", "legal", "tax"]},
        "revision": {"type": "integer", "minimum": 1},
        "status": {
          "enum": [
            "completed",
            "deep_review_pending",
            "not_assessable",
            "unsupported_pack",
            "expert_review_required"
          ]
        },
        "authority": {"enum": ["full", "provisional", "boundary"]},
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^finding_[0-9a-f]{24}$"}
        },
        "additional_data_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expert_role": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
