{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-relation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "schema_version",
    "run_id",
    "revision",
    "source_finding_id",
    "target_finding_id",
    "relation_type",
    "evidence_refs",
    "confidence_status",
    "contradicting_evidence_refs",
    "created_from_hash",
    "content_hash",
    "producer"
  ],
  "properties": {
    "relation_id": {"type": "string", "pattern": "^relation_[0-9a-f]{24}$"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_.-]+$"},
    "revision": {"type": "integer", "minimum": 0},
    "source_finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{24}$"},
    "target_finding_id": {"type": "string", "pattern": "^finding_[0-9a-f]{24}$"},
    "relation_type": {
      "enum": [
        "duplicate_of",
        "supports",
        "contradicts",
        "possible_cause_of",
        "possible_consequence_of",
        "shares_driver_with",
        "depends_on",
        "requires_joint_decision_with"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^evidence_[0-9a-f]{24}$"}
    },
    "confidence_status": {"enum": ["candidate", "provisional", "verified", "contested"]},
    "contradicting_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^evidence_[0-9a-f]{24}$"}
    },
    "created_from_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"const": "analysis_runtime"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relation_type": {
            "enum": ["possible_cause_of", "possible_consequence_of"]
          }
        }
      },
      "then": {"properties": {"confidence_status": {"const": "verified"}}}
    }
  ]
}
