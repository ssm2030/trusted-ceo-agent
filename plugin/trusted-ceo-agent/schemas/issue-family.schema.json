{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-family.schema.json",
  "title": "Professional Issue Family",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue_family_id", "domain", "industry_scope",
    "jurisdiction", "effective_from", "effective_to", "risk_level", "pack_id",
    "pack_version", "pack_hash", "pack_authority", "depth_slots",
    "required_test_case_types", "not_assessable_conditions", "family_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issue_family_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "industry_scope": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "minLength": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {
      "anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]
    },
    "risk_level": {"enum": ["standard", "high", "disputed"]},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "minLength": 1},
    "pack_hash": {"$ref": "knowledge-artifact.schema.json#/$defs/hash"},
    "pack_authority": {"enum": ["boundary", "provisional", "full"]},
    "depth_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D1", "D2", "D3", "D4", "D5", "D6",
        "D7", "D8", "D9", "D10", "D11", "D12"
      ],
      "properties": {
        "D1": {"$ref": "#/$defs/depthSlot"},
        "D2": {"$ref": "#/$defs/depthSlot"},
        "D3": {"$ref": "#/$defs/depthSlot"},
        "D4": {"$ref": "#/$defs/depthSlot"},
        "D5": {"$ref": "#/$defs/depthSlot"},
        "D6": {"$ref": "#/$defs/depthSlot"},
        "D7": {"$ref": "#/$defs/depthSlot"},
        "D8": {"$ref": "#/$defs/depthSlot"},
        "D9": {"$ref": "#/$defs/depthSlot"},
        "D10": {"$ref": "#/$defs/depthSlot"},
        "D11": {"$ref": "#/$defs/depthSlot"},
        "D12": {"$ref": "#/$defs/depthSlot"}
      }
    },
    "required_test_case_types": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "normal", "clear_error", "boundary", "counter_evidence",
          "missing_data", "mapping_error", "compound", "same_signal_different_cause",
          "cross_domain_conflict"
        ]
      }
    },
    "not_assessable_conditions": {
      "$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"
    },
    "family_hash": {"$ref": "knowledge-artifact.schema.json#/$defs/hash"}
  },
  "$defs": {
    "depthSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_type", "artifact_refs"],
      "properties": {
        "slot_type": {
          "enum": [
            "event_population", "impact", "expectation", "hypothesis_set",
            "norm", "procedure", "evidence_counter_evidence", "quantification",
            "action_candidates", "cross_domain_trigger", "limits_authority",
            "oracle_cases"
          ]
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "knowledge-artifact.schema.json#/$defs/artifactRef"}
        }
      }
    }
  }
}
