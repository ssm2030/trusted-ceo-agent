{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_id", "feedback_refs", "tenant_id", "reproduction", "failure_type", "root_cause", "target_artifacts", "before_semantics", "after_semantics", "source_refs", "affected_issue_family_ids", "affected_domains", "risk_classification", "regression_case_refs", "expected_behavior_changes", "forbidden_side_effects", "rollback_conditions", "required_stage2_roles", "trust_state", "status", "created_at", "patch_hash"],
  "$defs": {
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structured": {
      "type": "object", "additionalProperties": false,
      "required": ["facts", "criteria", "conclusions", "counter_evidence", "uncertainties", "verification_steps"],
      "properties": {
        "facts": {"$ref": "#/$defs/stringSet"}, "criteria": {"$ref": "#/$defs/stringSet"},
        "conclusions": {"$ref": "#/$defs/stringSet"}, "counter_evidence": {"$ref": "#/$defs/stringSet"},
        "uncertainties": {"$ref": "#/$defs/stringSet"}, "verification_steps": {"$ref": "#/$defs/stringSet"}
      }
    },
    "feedbackRef": {
      "type": "object", "additionalProperties": false, "required": ["feedback_id", "feedback_hash"],
      "properties": {"feedback_id": {"type": "string", "pattern": "^feedback_[0-9a-f]{24}$"}, "feedback_hash": {"$ref": "#/$defs/hash"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["artifact_ref", "artifact_hash", "artifact_type"],
      "properties": {"artifact_ref": {"type": "string", "minLength": 1}, "artifact_hash": {"$ref": "#/$defs/hash"}, "artifact_type": {"enum": ["kernel", "pack", "card", "component", "prompt", "parser", "mapping", "procedure", "norm", "method", "presentation"]}}
    },
    "regressionRef": {
      "type": "object", "additionalProperties": false, "required": ["regression_case_id", "regression_case_hash"],
      "properties": {"regression_case_id": {"type": "string", "pattern": "^regressioncase_[0-9a-f]{24}$"}, "regression_case_hash": {"$ref": "#/$defs/hash"}}
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "patch_id": {"type": "string", "pattern": "^patch_[0-9a-f]{24}$"},
    "feedback_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/feedbackRef"}},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "run_revision", "knowledge_release_id", "prompt_hash", "pack_hash", "component_hash", "result", "reproduction_hash"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "run_revision": {"type": "integer", "minimum": 0},
        "knowledge_release_id": {"type": "string", "minLength": 1}, "prompt_hash": {"$ref": "#/$defs/hash"},
        "pack_hash": {"$ref": "#/$defs/hash"}, "component_hash": {"$ref": "#/$defs/hash"},
        "result": {"const": "reproduced"}, "reproduction_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "failure_type": {"enum": ["ingestion", "mapping", "fact", "calculation", "expectation", "norm", "procedure", "counter", "routing", "cross_domain", "reasoning", "presentation", "evaluation"]},
    "root_cause": {"type": "string", "minLength": 1, "maxLength": 4096},
    "target_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "before_semantics": {"$ref": "#/$defs/structured"},
    "after_semantics": {"$ref": "#/$defs/structured"},
    "source_refs": {"$ref": "#/$defs/stringSet"},
    "affected_issue_family_ids": {"$ref": "#/$defs/stringSet"},
    "affected_domains": {"$ref": "#/$defs/stringSet"},
    "risk_classification": {"enum": ["low", "medium", "high", "critical"]},
    "regression_case_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/regressionRef"}},
    "expected_behavior_changes": {"$ref": "#/$defs/stringSet"},
    "forbidden_side_effects": {"$ref": "#/$defs/stringSet"},
    "rollback_conditions": {"$ref": "#/$defs/stringSet"},
    "required_stage2_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "trust_state": {"const": "machine_draft"},
    "status": {"const": "proposed"},
    "created_at": {"type": "string", "format": "date-time"},
    "patch_hash": {"$ref": "#/$defs/hash"}
  }
}
