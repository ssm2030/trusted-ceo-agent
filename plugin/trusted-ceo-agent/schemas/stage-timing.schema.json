{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-timing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_timing_id",
    "case_id",
    "workload_class",
    "condition",
    "profile_id",
    "repetition",
    "paired_seed",
    "stages_ms",
    "total_ms",
    "outcome",
    "telemetry_hash"
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage_timing_id": {"type": "string", "pattern": "^stagetiming_[0-9a-f]{24}$"},
    "case_id": {"type": "string", "pattern": "^evaluationcase_[0-9a-f]{24}$"},
    "workload_class": {"type": "string", "minLength": 1},
    "condition": {"enum": ["cold", "warm"]},
    "profile_id": {"enum": ["sequential", "parallel_2", "parallel_3", "parallel_4"]},
    "repetition": {"type": "integer", "minimum": 0},
    "paired_seed": {"$ref": "#/$defs/hash"},
    "stages_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake", "deterministic", "domain_reasoning", "integration", "render"],
      "properties": {
        "intake": {"type": "integer", "minimum": 0},
        "deterministic": {"type": "integer", "minimum": 0},
        "domain_reasoning": {"type": "integer", "minimum": 0},
        "integration": {"type": "integer", "minimum": 0},
        "render": {"type": "integer", "minimum": 0}
      }
    },
    "total_ms": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["completed", "timeout", "cancelled", "failed"]},
    "telemetry_hash": {"$ref": "#/$defs/hash"}
  }
}

