{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_id", "schema_version", "run_id", "base_revision", "action_id",
    "action_content_hash", "response_type", "payload", "actor_id",
    "response_hash", "idempotency_key_hash", "created_at"
  ],
  "properties": {
    "response_id": {"type": "string", "pattern": "^response_[0-9a-f]{24}$"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "integer", "minimum": 0},
    "action_id": {"type": "string", "pattern": "^action_[0-9a-f]{24}$"},
    "action_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_type": {"enum": [
      "confirm", "choose_one", "choose_many", "free_text", "provide_data",
      "provide_alternative_evidence", "proceed_limited", "exclude_scope",
      "request_explanation", "request_changes", "stop"
    ]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option_id": {"type": "string", "minLength": 1},
        "option_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "text": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "scope_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason": {"type": "string", "minLength": 1},
        "unavailable_reason": {"enum": ["not_collected", "inaccessible", "confidential", "no_permission", "time_limited", "other"]},
        "missing_source_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "missing_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "executable_procedure_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "unexecutable_procedure_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "affected_issue_family_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "affected_domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "expected_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "confirmed_limitations": {"const": true},
        "patch_operations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["op", "path"],
            "properties": {
              "op": {"enum": ["add", "replace", "test"]},
              "path": {"type": "string", "pattern": "^/"},
              "value": {}
            }
          }
        },
        "runtime_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimated_card_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "actor_id": {"type": "string", "minLength": 1},
    "response_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"response_type": {"const": "confirm"}}}, "then": {"properties": {"payload": {"maxProperties": 0}}}},
    {"if": {"properties": {"response_type": {"const": "choose_one"}}}, "then": {"properties": {"payload": {"required": ["option_id"]}}}},
    {"if": {"properties": {"response_type": {"const": "choose_many"}}}, "then": {"properties": {"payload": {"required": ["option_ids"]}}}},
    {"if": {"properties": {"response_type": {"const": "free_text"}}}, "then": {"properties": {"payload": {"required": ["text"]}}}},
    {"if": {"properties": {"response_type": {"const": "provide_data"}}}, "then": {"properties": {"payload": {"required": ["source_refs"]}}}},
    {"if": {"properties": {"response_type": {"const": "provide_alternative_evidence"}}}, "then": {"properties": {"payload": {"required": ["evidence_refs"]}}}},
    {"if": {"properties": {"response_type": {"const": "exclude_scope"}}}, "then": {"properties": {"payload": {"required": ["scope_refs", "reason"]}}}},
    {"if": {"properties": {"response_type": {"const": "request_explanation"}}}, "then": {"properties": {"payload": {"required": ["question"], "maxProperties": 1}}}},
    {"if": {"properties": {"response_type": {"const": "request_changes"}}}, "then": {"properties": {"payload": {"required": ["text"]}}}},
    {"if": {"properties": {"response_type": {"const": "stop"}}}, "then": {"properties": {"payload": {"required": ["reason"], "maxProperties": 1}}}},
    {
      "if": {"properties": {"response_type": {"const": "proceed_limited"}}},
      "then": {"properties": {"payload": {"required": [
        "unavailable_reason", "missing_source_roles", "missing_capabilities",
        "executable_procedure_refs", "unexecutable_procedure_refs",
        "affected_issue_family_refs", "affected_domains", "expected_limits",
        "confirmed_limitations"
      ]}}}
    }
  ]
}
