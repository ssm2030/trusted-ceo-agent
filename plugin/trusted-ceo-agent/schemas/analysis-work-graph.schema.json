{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-work-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "run_id",
    "base_revision",
    "signal_case_ids",
    "node_ids",
    "edge_ids",
    "required_node_ids",
    "policy_release_id",
    "concurrency_profile_id",
    "created_from_hash",
    "status",
    "checkpoint_ref"
  ],
  "properties": {
    "graph_id": {"type": "string", "pattern": "^graph_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]+$"},
    "base_revision": {"type": "integer", "minimum": 0},
    "signal_case_ids": {"$ref": "#/$defs/nonEmptyStringSet"},
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"},
      "uniqueItems": true
    },
    "edge_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^edge_[0-9a-f]{24}$"},
      "uniqueItems": true
    },
    "required_node_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^task_[0-9a-f]{24}$"},
      "uniqueItems": true
    },
    "policy_release_id": {"type": "string", "minLength": 1},
    "concurrency_profile_id": {
      "enum": ["sequential", "parallel_2", "parallel_3", "parallel_4"]
    },
    "created_from_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "pending",
        "running",
        "needs_prioritization",
        "needs_input",
        "deep_review_pending",
        "succeeded",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "checkpoint_ref": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    }
  },
  "$defs": {
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
