{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procedure-card.schema.json",
  "allOf": [
    {"$ref": "knowledge-artifact.schema.json#/$defs/base"},
    {
      "type": "object",
      "required": ["artifact_type", "content"],
      "properties": {
        "artifact_type": {"const": "procedure_card"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputs", "population", "calculations", "decision_conditions",
            "failure_states", "required_evidence_roles"
          ],
          "properties": {
            "inputs": {"$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"},
            "population": {"type": "string", "minLength": 1},
            "calculations": {"$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"},
            "decision_conditions": {"$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"},
            "failure_states": {"$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"},
            "required_evidence_roles": {"$ref": "knowledge-artifact.schema.json#/$defs/nonEmptyStringSet"}
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
