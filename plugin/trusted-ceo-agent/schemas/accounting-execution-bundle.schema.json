{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accounting-execution-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "release_id",
    "suite_hash",
    "run_id",
    "revision",
    "execution_manifest",
    "result_artifacts",
    "authority_ceiling",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "suite_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "suite_hash": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "execution_manifest": {"type": "object"},
    "result_artifacts": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/result_artifact"}
    },
    "authority_ceiling": {"const": "Boundary"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "family_ids", "content_hash", "payload"],
      "properties": {
        "result_type": {
          "enum": [
            "tier_zero",
            "core_extended",
            "revenue",
            "cashflow",
            "project_cost"
          ]
        },
        "family_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(AC|RV|CF|CA)-(0[1-9]|1[0-6])$"
          }
        },
        "content_hash": {"$ref": "#/$defs/sha256"},
        "payload": {"type": "object"}
      }
    }
  }
}
