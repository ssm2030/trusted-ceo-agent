{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasoning-job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_id", "stage", "artifact_ref", "mission_contract_hash", "pack_manifest_hash", "prompt_template_hash", "model_profile", "capability_ids", "allowed_fact_ids", "allowed_signal_ids", "allowed_mechanism_refs", "allowed_test_refs", "allowed_expert_trigger_refs", "allowed_decision_type_refs", "allowed_decision_unit_refs", "allowed_problem_family_refs", "allowed_response_refs", "required_signal_ids", "output_schema_ref", "limits_ref", "untrusted_text_markers"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]+$"},
    "stage": {"enum": ["schema_mapping", "lens", "integrated", "deep_dive", "writer"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "mission_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_template_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_profile": {"type": "string", "minLength": 1},
    "capability_ids": {"$ref": "#/$defs/stringSet"},
    "allowed_fact_ids": {"$ref": "#/$defs/stringSet"},
    "allowed_signal_ids": {"$ref": "#/$defs/stringSet"},
    "allowed_mechanism_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_test_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_expert_trigger_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_decision_type_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_decision_unit_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_problem_family_refs": {"$ref": "#/$defs/stringSet"},
    "allowed_response_refs": {"$ref": "#/$defs/stringSet"},
    "required_signal_ids": {"$ref": "#/$defs/stringSet"},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "limits_ref": {"type": "string", "minLength": 1},
    "untrusted_text_markers": {"$ref": "#/$defs/stringSet"},
    "mapping_question_refs": {"$ref": "#/$defs/nonEmptyStringSet"},
    "lens_id": {"type": "string", "minLength": 1},
    "shard_index": {"type": "integer", "minimum": 0},
    "shard_count": {"type": "integer", "minimum": 1},
    "join_manifest_ref": {"type": "string", "minLength": 1},
    "allowed_card_refs": {"$ref": "#/$defs/nonEmptyStringSet"},
    "approved_scope_ref": {"type": "string", "minLength": 1},
    "component_run_refs": {"$ref": "#/$defs/nonEmptyStringSet"},
    "structured_output_ref": {"type": "string", "minLength": 1},
    "allowed_claim_ids": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "stringSet": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyStringSet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "oneOf": [
    {"properties": {"stage": {"const": "schema_mapping"}, "lens_id": false, "shard_index": false, "shard_count": false, "join_manifest_ref": false, "allowed_card_refs": false, "approved_scope_ref": false, "component_run_refs": false, "structured_output_ref": false, "allowed_claim_ids": false}, "required": ["mapping_question_refs"]},
    {"properties": {"stage": {"const": "lens"}, "mapping_question_refs": false, "join_manifest_ref": false, "allowed_card_refs": false, "approved_scope_ref": false, "component_run_refs": false, "structured_output_ref": false, "allowed_claim_ids": false}, "required": ["lens_id", "shard_index", "shard_count"]},
    {"properties": {"stage": {"const": "integrated"}, "mapping_question_refs": false, "lens_id": false, "shard_index": false, "shard_count": false, "approved_scope_ref": false, "component_run_refs": false, "structured_output_ref": false, "allowed_claim_ids": false}, "required": ["join_manifest_ref", "allowed_card_refs"]},
    {"properties": {"stage": {"const": "deep_dive"}, "mapping_question_refs": false, "lens_id": false, "shard_index": false, "shard_count": false, "join_manifest_ref": false, "allowed_card_refs": false, "structured_output_ref": false, "allowed_claim_ids": false}, "required": ["approved_scope_ref", "component_run_refs"]},
    {"properties": {"stage": {"const": "writer"}, "mapping_question_refs": false, "lens_id": false, "shard_index": false, "shard_count": false, "join_manifest_ref": false, "allowed_card_refs": false, "approved_scope_ref": false, "component_run_refs": false}, "required": ["structured_output_ref", "allowed_claim_ids"]}
  ]
}
