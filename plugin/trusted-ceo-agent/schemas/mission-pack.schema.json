{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-pack.schema.json",
  "type": "object",
  "required": ["schema_version", "pack_type", "pack_id", "pack_version", "requested_authority", "title", "description", "applicability", "dependencies", "safety", "content"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_type": {"const": "mission"},
    "pack_id": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "requested_authority": {"enum": ["full", "provisional", "boundary"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "applicability": {"$ref": "#/$defs/applicability"},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety": {"$ref": "#/$defs/safety"},
    "content": {
      "type": "object",
      "required": ["customer_hypothesis_policy", "required_challenge_policy", "reasoning_sequence", "result_grade_definitions", "required_output_sections", "professional_boundaries", "hitl_minimum_gates", "trust_kernel_rules", "default_privacy_policy", "model_role_profiles", "default_limits"],
      "properties": {
        "customer_hypothesis_policy": {"type": "object"},
        "required_challenge_policy": {"type": "object"},
        "reasoning_sequence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "result_grade_definitions": {"type": "array", "items": {"type": "object"}, "minItems": 6},
        "required_output_sections": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "professional_boundaries": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "hitl_minimum_gates": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
        "trust_kernel_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "default_privacy_policy": {"type": "object"},
        "model_role_profiles": {"type": "array", "items": {"type": "object"}},
        "default_limits": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "applicability": {
      "type": "object",
      "required": ["business_models", "industries", "excluded_industries", "required_data_roles"],
      "properties": {
        "business_models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "industries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded_industries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_data_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["forbidden_interpretations", "safe_stop_rules"],
      "properties": {
        "forbidden_interpretations": {"type": "array", "items": {"type": "string"}},
        "safe_stop_rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
