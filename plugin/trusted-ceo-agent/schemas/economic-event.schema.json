{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economic-event.schema.json",
  "$defs": {
    "factRefs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^fact_[0-9a-f]{24}$"},
      "uniqueItems": true
    },
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ref", "root_fact_refs", "sources", "evidence_link_refs"],
      "properties": {
        "fact_ref": {"type": "string", "pattern": "^fact_[0-9a-f]{24}$"},
        "root_fact_refs": {"$ref": "#/$defs/factRefs", "minItems": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_sha256", "lineage_set_refs"],
            "properties": {
              "source_id": {"type": "string", "pattern": "^source_[0-9a-f]{24}$"},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "lineage_set_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^lineage/sets/[0-9a-f]{64}\\.json$"}
              }
            }
          }
        },
        "evidence_link_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^evidence_[0-9a-f]{24}$"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "base_revision", "evidence_core_ref",
    "party_roles", "rights", "obligations", "resource_and_control", "consideration",
    "conditions", "event_dates", "performance_state", "billing_state", "payment_state",
    "cancellation_state", "amounts", "incentives", "document_refs", "system_event_refs",
    "fact_refs", "source_lineage", "data_quality_refs", "materialization", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^event_[0-9a-f]{24}$"},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "base_revision": {"type": "integer", "minimum": 1},
    "evidence_core_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_hash", "payload_hash", "revision"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{24}$"},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "party_roles": {"$ref": "#/$defs/factRefs"},
    "rights": {"$ref": "#/$defs/factRefs"},
    "obligations": {"$ref": "#/$defs/factRefs"},
    "resource_and_control": {"$ref": "#/$defs/factRefs"},
    "consideration": {"$ref": "#/$defs/factRefs"},
    "conditions": {"$ref": "#/$defs/factRefs"},
    "event_dates": {"$ref": "#/$defs/factRefs"},
    "performance_state": {"$ref": "#/$defs/factRefs"},
    "billing_state": {"$ref": "#/$defs/factRefs"},
    "payment_state": {"$ref": "#/$defs/factRefs"},
    "cancellation_state": {"$ref": "#/$defs/factRefs"},
    "amounts": {"$ref": "#/$defs/factRefs"},
    "incentives": {"$ref": "#/$defs/factRefs"},
    "document_refs": {"$ref": "#/$defs/factRefs"},
    "system_event_refs": {"$ref": "#/$defs/factRefs"},
    "fact_refs": {"$ref": "#/$defs/factRefs", "minItems": 1},
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceLineage"}
    },
    "data_quality_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^quality_[0-9a-f]{24}$"}
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "input_hash"],
      "properties": {
        "producer": {"const": "deterministic_component"},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_hash"],
      "properties": {"payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
