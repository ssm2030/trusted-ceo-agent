{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-contract.schema.json",
  "type": "object",
  "required": ["component_id", "version", "supported_input_fact_codes", "required_dimensions", "parameter_schema", "output_fact_codes", "output_signal_codes", "failure_reason_codes", "parallel_safe", "max_input_records", "timeout_seconds"],
  "properties": {
    "component_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supported_input_fact_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parameter_schema": {"type": "object"},
    "output_fact_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_signal_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failure_reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parallel_safe": {"const": true},
    "max_input_records": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
