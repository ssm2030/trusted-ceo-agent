{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-response-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "policy_version", "transport_principal",
    "authorized_actors", "restricted_source_allowlist", "privacy_policy",
    "policy_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "transport_principal": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorized_actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "roles", "allowed_gates"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "allowed_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["context", "data", "scope_narrowing", "diagnostic", "final"]
            }
          }
        }
      }
    },
    "restricted_source_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source_[0-9a-f]{24}$"}
    },
    "privacy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_identifier_reasoning", "minimum_group_size"],
      "properties": {
        "direct_identifier_reasoning": {"const": "forbidden"},
        "minimum_group_size": {"type": "integer", "minimum": 2}
      }
    },
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
