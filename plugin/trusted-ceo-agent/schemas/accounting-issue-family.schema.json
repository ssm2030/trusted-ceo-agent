{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accounting-issue-family.schema.json",
  "title": "Accounting Issue Family Seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issue_family_id", "cycle_id", "title", "review_lens",
    "economic_event_types", "accounts", "assertions", "population_definition",
    "mandatory_data_roles", "optional_data_roles", "expectation_card_refs",
    "norm_card_refs", "procedure_card_refs", "counter_hypothesis_refs",
    "calculation_refs", "cross_domain_trigger_refs", "required_test_case_types",
    "authority_ceiling", "not_assessable_conditions", "depth_gate_refs",
    "depth_gate_status", "deterministic_procedure_summary", "quantification_output",
    "source_design_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "issue_family_id": {"type": "string", "pattern": "^(AC|RV|CF|CA)-[0-9]{2}$"},
    "cycle_id": {
      "enum": [
        "accounting_core", "contract_revenue", "cash_flow_working_capital",
        "project_cost_allocation"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "review_lens": {"type": "string", "minLength": 1},
    "economic_event_types": {"$ref": "#/$defs/non_empty_string_set"},
    "accounts": {"$ref": "#/$defs/non_empty_string_set"},
    "assertions": {"$ref": "#/$defs/non_empty_string_set"},
    "population_definition": {"type": "string", "minLength": 1},
    "mandatory_data_roles": {"$ref": "#/$defs/non_empty_string_set"},
    "optional_data_roles": {"$ref": "#/$defs/string_set"},
    "expectation_card_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "norm_card_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "procedure_card_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "counter_hypothesis_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "calculation_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "cross_domain_trigger_refs": {"$ref": "#/$defs/non_empty_string_set"},
    "required_test_case_types": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["normal", "error", "boundary", "counter_evidence", "compound"]}
    },
    "authority_ceiling": {"const": "Boundary"},
    "not_assessable_conditions": {"$ref": "#/$defs/non_empty_string_set"},
    "depth_gate_refs": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^D([1-9]|1[0-2])$"}
    },
    "depth_gate_status": {
      "enum": ["not_evaluated", "passed", "failed", "expert_review_required"]
    },
    "deterministic_procedure_summary": {"type": "string", "minLength": 1},
    "quantification_output": {"type": "string", "minLength": 1},
    "source_design_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "string_set": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "non_empty_string_set": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
