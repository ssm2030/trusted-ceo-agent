{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regression-case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "regression_case_id", "source_feedback_refs", "fixture_kind", "fixture_ref", "fixture_hash", "consent_ref", "expected", "negative_control_refs", "counterexample_refs", "created_at", "regression_case_hash"],
  "$defs": {
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "structured": {
      "type": "object", "additionalProperties": false,
      "required": ["facts", "criteria", "conclusions", "counter_evidence", "uncertainties", "verification_steps"],
      "properties": {
        "facts": {"$ref": "#/$defs/stringSet"}, "criteria": {"$ref": "#/$defs/stringSet"},
        "conclusions": {"$ref": "#/$defs/stringSet"}, "counter_evidence": {"$ref": "#/$defs/stringSet"},
        "uncertainties": {"$ref": "#/$defs/stringSet"}, "verification_steps": {"$ref": "#/$defs/stringSet"}
      }
    },
    "feedbackRef": {
      "type": "object", "additionalProperties": false,
      "required": ["feedback_id", "feedback_hash"],
      "properties": {
        "feedback_id": {"type": "string", "pattern": "^feedback_[0-9a-f]{24}$"},
        "feedback_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "regression_case_id": {"type": "string", "pattern": "^regressioncase_[0-9a-f]{24}$"},
    "source_feedback_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/feedbackRef"}},
    "fixture_kind": {"enum": ["synthetic", "deidentified_real"]},
    "fixture_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consent_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024},
    "expected": {"$ref": "#/$defs/structured"},
    "negative_control_refs": {"$ref": "#/$defs/stringSet"},
    "counterexample_refs": {"$ref": "#/$defs/stringSet"},
    "created_at": {"type": "string", "format": "date-time"},
    "regression_case_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
