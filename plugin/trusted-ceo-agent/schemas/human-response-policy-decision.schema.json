{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-response-policy-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "policy_version", "policy_hash",
    "action_id", "response_id", "gate", "actor_id", "transport_subject",
    "allowed", "reason_codes", "evaluated_source_refs", "created_at",
    "decision_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_id": {"type": "string", "pattern": "^action_[0-9a-f]{24}$"},
    "response_id": {"type": "string", "pattern": "^response_[0-9a-f]{24}$"},
    "gate": {"type": "string", "minLength": 1, "maxLength": 128},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "transport_subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "allowed": {"type": "boolean"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "authorized",
          "transport_principal_mismatch",
          "transport_role_not_authorized",
          "actor_not_authorized",
          "gate_not_authorized",
          "response_binding_mismatch",
          "source_registry_missing",
          "source_registry_invalid",
          "source_not_registered",
          "source_prohibited",
          "source_restricted_not_allowlisted"
        ]
      }
    },
    "evaluated_source_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^source_[0-9a-f]{24}$"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "decision_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"allowed": {"const": true}}},
      "then": {"properties": {"reason_codes": {"const": ["authorized"]}}}
    },
    {
      "if": {"properties": {"allowed": {"const": false}}},
      "then": {
        "properties": {
          "reason_codes": {
            "not": {"contains": {"const": "authorized"}}
          }
        }
      }
    }
  ]
}
