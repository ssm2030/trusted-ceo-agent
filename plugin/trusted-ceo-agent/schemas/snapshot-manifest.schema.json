{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "parent_revision", "files", "manifest_hash"],
  "properties": {
    "revision": {"type": "integer", "minimum": 1}, "parent_revision": {"type": "integer", "minimum": 0},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
